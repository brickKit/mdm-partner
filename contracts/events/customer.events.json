{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdm-customer 事件清单",
  "note": "只增不改：可以加字段、加事件，不删字段、不改类型、不改 subject。消费者宽容反序列化（不认识的字段忽略）。",
  "envelope": {
    "description": "所有事件共用的信封，由 be-sdk 的 Outbox 填写与校验",
    "required": ["subject", "aggregate_id", "version", "trace_id", "causation_id", "hop_count", "occurred_at"],
    "properties": {
      "subject":      { "type": "string", "pattern": "^[a-z]+\\.[a-z-]+\\.[a-z-]+\\.v[0-9]+$" },
      "aggregate_id": { "type": "string" },
      "version":      { "type": "integer", "description": "聚合版本，单调递增；消费者只在严格大于本地当前值时更新，因此不怕乱序与重复投递" },
      "trace_id":     { "type": "string" },
      "causation_id": { "type": "string" },
      "hop_count":    { "type": "integer", "maximum": 5, "description": "事件链跳数；大于 5 直接进死信队列，防止事件互相触发成环" },
      "occurred_at":  { "type": "string", "format": "date-time" }
    }
  },
  "events": [
    {
      "subject": "mdm.customer.created.v1",
      "grade": "core",
      "note": "核心事件：经 Outbox 持久化，消费者必须幂等，处理失败进死信队列",
      "payload": {
        "type": "object",
        "required": ["id", "code", "name", "status", "version"],
        "properties": {
          "id":           { "type": "string" },
          "code":         { "type": "string" },
          "name":         { "type": "string" },
          "tax_no":       { "type": "string" },
          "credit_limit": { "type": "string" },
          "status":       { "type": "string", "enum": ["ACTIVE", "DISABLED"] },
          "version":      { "type": "integer" }
        }
      }
    },
    {
      "subject": "mdm.customer.updated.v1",
      "grade": "core",
      "payload": {
        "type": "object",
        "required": ["id", "name", "status", "version"],
        "properties": {
          "id":           { "type": "string" },
          "name":         { "type": "string" },
          "tax_no":       { "type": "string" },
          "credit_limit": { "type": "string" },
          "status":       { "type": "string", "enum": ["ACTIVE", "DISABLED"] },
          "version":      { "type": "integer" }
        }
      }
    },
    {
      "subject": "mdm.customer.disabled.v1",
      "grade": "core",
      "payload": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id":      { "type": "string" },
          "version": { "type": "integer" }
        }
      }
    }
  ]
}
